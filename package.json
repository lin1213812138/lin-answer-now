{
  "name": "lin-answer-now",
  "version": "1.2.1",
  "private": false,
  "type": "module",
  "description": "Push the agent to deliver its answer as soon as it has one instead of running extra queries.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "efficiency",
    "tool-calls",
    "productivity"
  ],
  "license": "MIT",
  "author": "lin1213812138",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lin1213812138/lin-answer-now.git"
  },
  "homepage": "https://github.com/lin1213812138/lin-answer-now#readme",
  "bugs": "https://github.com/lin1213812138/lin-answer-now/issues",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1 || ^0.1.3-alpha.1 || ^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
